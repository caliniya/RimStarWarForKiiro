<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 高级研究台:星际级技术(本模组 Ultra 级科技)的专属研究设施 -->
	<ThingDef ParentName="BuildingBase">
		<defName>StarWarKiiro_AdvancedResearchBench</defName>
		<label>高级研究台</label>
		<description>整合了太空时代仪器与全息投影终端的高级研究平台。星际级技术的研究必需在此进行。</description>
		<thingClass>Building_ResearchBench</thingClass>
		<size>(5,2)</size>
		<minifiedDef/>
		<thingCategories Inherit="false"/>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>150</costStuffCount>
		<costList>
			<Steel>150</Steel>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>20</ComponentIndustrial>
			<ComponentSpacer>5</ComponentSpacer>
		</costList>
		<graphicData>
			<texPath>Things/Building/Production/StarWarKiiro_AdvResearchBench</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(7,3.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>8000</WorkToBuild>
			<Flammability>0.5</Flammability>
			<ResearchSpeedFactor>1.25</ResearchSpeedFactor>
		</statBases>
		<comps Inherit="False">
			<li Class="CompProperties_ReportWorkSpeed">
				<workSpeedStat>ResearchSpeedFactor</workSpeedStat>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>450</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>MultiAnalyzer</li>
				</linkableFacilities>
			</li>
		</comps>
		<fillPercent>0.5</fillPercent>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<hasInteractionCell>true</hasInteractionCell>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Production</designationCategory>
		<uiOrder>2611</uiOrder>
		<surfaceType>Item</surfaceType>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>StarWarKiiro_AdvancedResearchBench</li>
		</researchPrerequisites>
		<building>
			<workTableRoomRole>Laboratory</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
		</building>
	</ThingDef>

</Defs>
