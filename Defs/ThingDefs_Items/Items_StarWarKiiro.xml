	<ThingDef ParentName="ResourceBase">
		<defName>StarWarKiiro_HighExplosive</defName>
		<label>高能炸药</label>
		<description>化学合成的高功率装药,导弹战斗部与工程爆破的核心原料。注意远离火源。</description>
		<graphicData>
			<texPath>Things/Item/Resource/StarWarKiiro_HighExplosive</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<statBases>
			<MarketValue>26</MarketValue>
			<Mass>0.5</Mass>
		</statBases>
		<stackLimit>25</stackLimit>
		<useHitPoints>true</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>2.4</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<startWickHitPointsPercent>0.5</startWickHitPointsPercent>
				<startWickOnDamageTaken>
					<li>Flame</li>
					<li>Bomb</li>
				</startWickOnDamageTaken>
				<wickTicks>120</wickTicks>
				<chanceNeverExplodeFromDamage>0.3</chanceNeverExplodeFromDamage>
			</li>
		</comps>
	</ThingDef>

